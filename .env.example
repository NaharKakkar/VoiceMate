# Required for Gemini-powered voice understanding and meeting/email summaries
GEMINI_API_KEY=YOUR GEMINI_API_KEY
# add gemini model
# GEMINI_MODEL=gemini-3-flash-preview        



# Gmail OAuth (optional until Gmail feature is used)
# For production, set these to the live HTTPS URL of your deployed app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-production-domain.example/auth/google/callback
FRONTEND_URL=https://your-frontend-domain.example
PUBLIC_BASE_URL=https://your-production-domain.example

PORT=3000

