{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://voicemate-ucxl.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://voicemate-ucxl.onrender.com/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
